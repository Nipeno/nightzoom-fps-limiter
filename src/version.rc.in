// Windows VERSIONINFO resource for NZ-FPS-Limiter.addon64.
//
// Generated by CMake from this template (configure_file, @ONLY): @NZ_VERSION@ /
// @NZ_VERSION_COMMA@ are substituted at configure time. The installer reads the
// resulting FILEVERSION back off the installed .addon64 to decide install vs update.
// Do not edit the generated build/version.rc — edit this template instead.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @NZ_VERSION_COMMA@
 PRODUCTVERSION @NZ_VERSION_COMMA@
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"   // U.S. English, Unicode
        BEGIN
            VALUE "CompanyName",      "NightZoom"
            VALUE "FileDescription",  "NightZoom FPS Limiter - ReShade addon that caps the game to 60 FPS"
            VALUE "FileVersion",      "@NZ_VERSION@"
            VALUE "InternalName",     "NZ-FPS-Limiter"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Nipeno. GPLv3."
            VALUE "OriginalFilename", "NZ-FPS-Limiter.addon64"
            VALUE "ProductName",      "NightZoom FPS Limiter"
            VALUE "ProductVersion",   "@NZ_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200   // U.S. English, Unicode codepage
    END
END
