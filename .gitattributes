# Normalize line endings so a checkout is identical on every machine, regardless of
# whatever core.autocrlf the contributor happens to have set.
* text=auto eol=lf

# Windows shell scripts must keep CRLF. Enable-ReShade.bat is a cmd/PowerShell polyglot
# that ships inside the release zip and runs on end users' machines.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Windows resource scripts are compiled by rc.exe on Windows only.
*.rc     text eol=crlf
*.rc.in  text eol=crlf

# Never touch these.
*.png binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
*.addon64 binary
