{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NZ-FPS-Limiter-Installer",
  "version": "1.0.0",
  "identifier": "gg.nightzoom.fpslimiter.installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NightZoom Setup",
        "label": "main",
        "width": 760,
        "height": 540,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
